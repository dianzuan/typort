            </m:r>
          </m:sub>
        </m:sSub>
      </m:den>
    </m:f>
    <m:r>
      <m:t>=</m:t>
    </m:r>
    <m:sSup>
      <m:e>
        <m:d>
          <m:dPr>
            <m:begChr m:val="("/>
            <m:endChr m:val=")"/>
          </m:dPr>
          <m:e>
            <m:sSub>
              <m:e>
                <m:r>
                  <m:t>I</m:t>
                </m:r>
              </m:e>
              <m:sub>
                <m:r>
                  <m:t>n</m:t>
                </m:r>
              </m:sub>
            </m:sSub>
            <m:r>
              <m:t>−</m:t>
            </m:r>
            <m:r>
              <m:t>ρ</m:t>
            </m:r>
            <m:r>
              <m:t>W</m:t>
            </m:r>
          </m:e>
        </m:d>
      </m:e>
      <m:sup>
        <m:r>
          <m:t>−</m:t>
        </m:r>
        <m:r>
          <m:t>1</m:t>
        </m:r>
      </m:sup>
    </m:sSup>
    <m:d>
      <m:dPr>
        <m:begChr m:val="("/>
        <m:endChr m:val=")"/>
      </m:dPr>
      <m:e>
        <m:sSub>
          <m:e>
