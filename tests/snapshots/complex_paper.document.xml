              <m:t>n</m:t>
            </m:r>
          </m:sub>
        </m:sSub>
        <m:sSub>
          <m:e>
            <m:r>
              <m:t>β</m:t>
            </m:r>
          </m:e>
          <m:sub>
            <m:r>
              <m:t>k</m:t>
            </m:r>
          </m:sub>
        </m:sSub>
        <m:r>
          <m:t>+</m:t>
        </m:r>
        <m:r>
